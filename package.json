{
  "name": "@sweetcornna/open-claude-code",
  "version": "2.46.3",
  "license": "AGPL-3.0-or-later",
  "description": "Community edition of the Anthropic Claude Code CLI — a reverse-engineered restoration with community optimizations; interactive AI coding assistant in the terminal",
  "type": "module",
  "author": "open-claude-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweetcornna/open-claude-code.git"
  },
  "homepage": "https://github.com/sweetcornna/open-claude-code#readme",
  "bugs": {
    "url": "https://github.com/sweetcornna/open-claude-code/issues"
  },
  "keywords": [
    "claude",
    "anthropic",
    "cli",
    "ai",
    "coding-assistant",
    "terminal",
    "repl"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "bin": {
    "occ": "dist/cli-node.js",
    "occ-bun": "dist/cli-bun.js",
    "open-claude-code": "dist/cli-node.js",
    "qm": "dist/cli-qianmo.js"
  },
  "workspaces": [
    "packages/*",
    "packages/@ant/*"
  ],
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "scripts/run-parallel.mjs"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:vite": "vite build && bun run scripts/post-build.ts",
    "build:vite:only": "vite build",
    "build:bun": "bun run build.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:inspect": "bun run scripts/dev-debug.ts",
    "prepublishOnly": "bun run build:vite",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "prepare": "husky",
    "test": "bun test",
    "test:shipped-features": "bun run scripts/test-shipped-features.ts",
    "check:bundle": "bun run scripts/check-bundle-integrity.ts && bun run scripts/check-bundle-smoke.ts",
    "check:unused": "bun run scripts/check-unused.ts",
    "check:unused:raw": "knip-bun",
    "sync:docs-i18n": "bun run scripts/sync-docs-i18n.ts",
    "check:docs-i18n": "bun run scripts/check-docs-i18n.ts",
    "check:cycles": "bun run scripts/check-cycles.ts",
    "check:prompt-purity": "bun run scripts/check-prompt-purity.ts",
    "check:mock-hygiene": "bun run scripts/check-mock-hygiene.ts",
    "check:macro-guards": "bun run scripts/check-macro-guards.ts",
    "check:identity-paths": "bun run scripts/check-identity-paths.ts",
    "check:license-headers": "bun run scripts/check-license-headers.ts",
    "verify:p32": "bun run scripts/qianmo-programming-tasks.ts",
    "qianmo:nxn-matrix": "bun run scripts/qianmo-nxn-resolution-matrix.ts",
    "qianmo:policy-probes": "bun run scripts/qianmo-policy-switch-probes.ts",
    "qianmo:acceptance": "bun run scripts/qianmo-acceptance.ts",
    "qianmo:recall-baseline": "bun run scripts/qianmo-recall-baseline.ts",
    "sbom": "bun run scripts/sbom.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "docs:dev": "npx mintlify dev",
    "typecheck": "tsc --noEmit",
    "precheck": "bun run typecheck && bun run check:fix && bun run check:prompt-purity && bun run check:mock-hygiene && bun run check:macro-guards && bun run check:identity-paths && bun run check:license-headers && bun test && bun run test:shipped-features",
    "verify": "biome ci . && bun run typecheck && bun run check:prompt-purity && bun run check:mock-hygiene && bun run check:macro-guards && bun run check:identity-paths && bun run check:license-headers && bun run check:docs-i18n && bun run check:cycles && ./scripts/test-shards.sh && bun run test:shipped-features && bun run build:vite && bun run check:bundle && bun run check:unused"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "fflate": "^0.8.3",
