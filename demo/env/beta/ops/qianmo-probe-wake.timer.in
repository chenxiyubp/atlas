#
# 阡陌内测 · 探针定时器（wake）：每 10 分钟一格：按轮转表唤醒一个节点。
# 由 fleet-probe.sh install 装、只 enable 不 start——开始计时是一个有意的动作。

[Unit]
Description=Qianmo beta fleet probe timer (wake)

[Timer]
OnCalendar=*-*-* *:0/10:15
AccuracySec=1s
Unit=qianmo-probe@wake.service

[Install]
WantedBy=timers.target
