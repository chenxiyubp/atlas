#
# 阡陌内测 · H → 见证机的 ssh -L（systemd --user 单元，P11.4 形态②）。
#
# **这是模板**，由 `witness-endpoint.sh link-install` 派生；连接参数在 <内测根>/ops/witness-link.env，
# 单元里只有变量名。为什么要这一条、W 那一侧的 authorized_keys 该怎么限，见 witness-endpoint.sh 头注。
#
# 节点的锚点经隧道的 `-R` 落在 H 的回环 38640 上，这条 `-L` 再把它接到见证机的回环端点。
# 它断了，节点照常跑：锚点只在节点 stderr 里报一句写不进去（发送方 fail-open），控制台的
# 审计页退回「未见证」；连回来之后锚定自己续上。
#
# StrictHostKeyChecking=yes：见证机的主机公钥必须事先核对指纹再放进 known_hosts，
# link-install 会先查；这里不做首次信任。
# 变量一律带花括号：每个都是一个参数，不需要分词。
#
# 存活判据不是单元状态：
#   curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:38640/v0/anchor   # 不带 token 要 401

[Unit]
Description=Qianmo beta witness link (H loopback -> witness host loopback, ssh -L)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
EnvironmentFile=@OPS_DIR@/witness-link.env
ExecStart=/usr/bin/ssh -i ${WITNESS_SSH_KEY} -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o ConnectTimeout=15 -p ${WITNESS_SSH_PORT} -L 127.0.0.1:${WITNESS_LOCAL_PORT}:127.0.0.1:${WITNESS_REMOTE_PORT} ${WITNESS_SSH_USER}@${WITNESS_SSH_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
